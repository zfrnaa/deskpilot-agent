# DeskPilot Environment Configuration

# 1. Notion API Integration
NOTION_TOKEN=secret_your_notion_api_token_here

# Notion Target Destinations (Page / Database IDs)
NOTION_READ_LATER_DATABASE_ID=your_read_later_newsfeed_database_id_here
NOTION_WORK_NOTES_DATABASE_ID=your_worknote_database_id_here
NOTION_DUE_DILIGENCE_PAGE_ID=your_due_diligence_questionnaire_page_id_here
NOTION_BRAINSTORM_PAGE_ID=your_brainstorm_session_page_id_here

# Fallback generic parent page ID (optional)
NOTION_PARENT_PAGE_ID=

# 2. Vision LLM Configuration (For Screenshot Triage)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Optional LangSmith Observability & Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DeskPilot
# Legacy LangChain environment variables (also supported)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=DeskPilot
